\contentsline {figure}{\numberline {1.1}{\ignorespaces Examples of shoreline misidentification in a macrotidal beach (adapted from \citealp {cabezas_site-specific_2026})}}{10}{}%
\contentsline {figure}{\numberline {1.2}{\ignorespaces Schematic representation of the methodological workflow.}}{13}{}%
