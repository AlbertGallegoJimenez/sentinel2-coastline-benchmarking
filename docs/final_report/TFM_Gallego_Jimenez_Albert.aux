\@writefile{lof}{\contentsline {figure}{\numberline {3.7}{\ignorespaces Example of the pixel-based evaluation mask. The left panel shows the original RGB image. The dynamic evaluation buffer (right) highlights the 10-pixel zone around the GT waterline where the pixel-based metrics are calculated, effectively excluding the deep water and inland areas from the evaluation.}}{44}{}\protected@file@percent }
\newlabel{fig:evaluation_mask}{{3.7}{44}{}{figure.3.7}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.7.3}Geometric Evaluation}{45}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3.8}{\ignorespaces Example of the perpendicular transect methodology for geometric evaluation. The black line represents the manually digitized GT waterline, while the purple line represents the predicted waterline from either the DL or index-based method (in this case, MNDWI using Zero threshold). The yellow line is the fixed landward baseline. The cyan lines are the perpendicular transects cast from the baseline to the predicted and GT waterlines. The offset is calculated as the absolute distance between the intersection points of the predicted and GT waterlines along each transect.}}{46}{}\protected@file@percent }
\newlabel{fig:transect_methodology}{{3.8}{46}{}{figure.3.8}{}}
