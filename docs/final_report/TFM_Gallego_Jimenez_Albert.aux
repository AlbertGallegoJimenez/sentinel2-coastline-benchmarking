\@writefile{toc}{\contentsline {section}{\numberline {4.1}Physical Context: Sand Reflectance and Colorimetric Assessment}{49}{}\protected@file@percent }
\newlabel{sec:results_sand_reflectance}{{4.1}{49}{}{section.4.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.1}{\ignorespaces Comparison of the sand reflectance metrics between El Puntal and Salinas. The left panel displays the absolute albedo proxy ($\bar  {\rho }_{RGB}$), while the right panel highlights the colorimetric slope ($\Delta _{R-B}$). Boxplots represent the interquartile range and median, with overlaid stripplots detailing individual scene observations.}}{50}{}\protected@file@percent }
\newlabel{fig:reflectance_boxplots}{{4.1}{50}{}{figure.4.1}{}}
\@writefile{toc}{\contentsline {section}{\numberline {4.2}Deep Learning Pixel-based Performance}{50}{}\protected@file@percent }
\newlabel{sec:results_pixel_eval}{{4.2}{50}{}{section.4.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.2}{\ignorespaces Pixel-based performance distributions (IoU and Dice coefficient) for the four annotated coastal classes, disaggregated by study area. The networks demonstrate exceptional accuracy for standard macro-features (Water, Sand) and maintain highly robust predictions for the morphodynamically complex Wet Sand. The performance drop in White Water at El Puntal is directly attributed to the physical scarcity of wave foam in the sheltered estuarine environment.}}{51}{}\protected@file@percent }
\newlabel{fig:multiclass_performance}{{4.2}{51}{}{figure.4.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.3}{\ignorespaces Binary classification performance (Water vs. Non-water) and architectural efficiency. The right panel displays the Mean IoU on a standard 0-1 scale, highlighting the generalized predictive saturation across all models. The left panel maps the Mean IoU against the total parameter count, demonstrating that highly efficient encoders ($\sim $25M parameters, such as MiT-B2) systematically outperform their heavier, overparameterized counterparts ($>$60M parameters).}}{53}{}\protected@file@percent }
\newlabel{fig:binary_efficiency}{{4.3}{53}{}{figure.4.3}{}}
\@writefile{toc}{\contentsline {section}{\numberline {4.3}Geometric Evaluation: Cross-shore Offsets}{53}{}\protected@file@percent }
\newlabel{sec:results_geometric_eval}{{4.3}{53}{}{section.4.3}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.3.1}Overarching Family Performance (Index-based vs. Deep Learning)}{53}{}\protected@file@percent }
\newlabel{subsec:overarching_performance}{{4.3.1}{53}{}{subsection.4.3.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.4}{\ignorespaces Distribution of cross-shore extraction offsets by model family. The left panel (Boxplot) displays the aggregated global performance, highlighting the median and interquartile range (IQR). The right panel (Violin plot) disaggregates the errors by study area (El Puntal vs. Salinas), emphasizing the severe performance degradation of index-based methods in complex environments compared to the geographic robustness of DL models.}}{54}{}\protected@file@percent }
\newlabel{fig:overall_family_boxplots}{{4.4}{54}{}{figure.4.4}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.3.2}Intra-Family Model Assessment and Spatial Bias}{55}{}\protected@file@percent }
\newlabel{subsec:intra_family_assessment}{{4.3.2}{55}{}{subsection.4.3.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.5}{\ignorespaces Mean Absolute Error (MAE) heatmaps for intra-family configuration assessment. The left panel details the performance of spectral indices across different thresholding techniques, highlighting extreme variance. The right panel displays the Deep Learning configurations, demonstrating high stability and the superiority of the U-Net (MiT-B2) hybrid architecture.}}{56}{}\protected@file@percent }
\newlabel{fig:mae_heatmaps}{{4.5}{56}{}{figure.4.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.6}{\ignorespaces Hexbin error distributions for Index-based models. The plots map the predicted shoreline position (SDW) against the reference waterline (RWL). The dashed white line represents the 1:1 perfect agreement. Most indices show a severe Landward bias (wet sand confusion), while NDWI shows a Seaward bias (foam confusion). SCoWI (LM Otsu) stands out as the most accurate traditional method.}}{58}{}\protected@file@percent }
\newlabel{fig:hexbins_index}{{4.6}{58}{}{figure.4.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.7}{\ignorespaces Hexbin error distributions for Deep Learning semantic segmentation models. In contrast to the traditional baseline, all DL configurations demonstrate minimal dispersion, uniformly tight clustering around the 1:1 bisector ($R^2 \ge 0.96$), and the complete elimination of extreme cross-shore biases.}}{59}{}\protected@file@percent }
\newlabel{fig:hexbins_dl}{{4.7}{59}{}{figure.4.7}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.3.3}Spatial and Environmental Drivers of Error}{60}{}\protected@file@percent }
\newlabel{subsec:spatial_environmental_drivers}{{4.3.3}{60}{}{subsection.4.3.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.8}{\ignorespaces Alongshore variability of extraction offsets for Index-based models. The upper map panels reference the geographical location of the cross-shore transects. The boxplots show the error distribution per \texttt  {transect\_id} compared to the overall site performance (right sub-panels).}}{61}{}\protected@file@percent }
\newlabel{fig:transects_index}{{4.8}{61}{}{figure.4.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.9}{\ignorespaces Alongshore variability of extraction offsets for Deep Learning models. The upper map panels reference the geographical location of the cross-shore transects. The boxplots show the error distribution per \texttt  {transect\_id} compared to the overall site performance (right sub-panels).}}{62}{}\protected@file@percent }
\newlabel{fig:transects_dl}{{4.9}{62}{}{figure.4.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.10}{\ignorespaces Relative performance sensitivity to hydrodynamic forcing. The plots display the percentage change in the median offset ($\Delta \%$) relative to the overall site median across astronomical tide (left) and significant wave height (right) quartiles. Absolute median values are annotated for each quartile to contextualize the operational impact of these relative changes.}}{64}{}\protected@file@percent }
\newlabel{fig:quartiles_relative}{{4.10}{64}{}{figure.4.10}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.3.4}Cross-Site Generalization and Robustness}{64}{}\protected@file@percent }
\newlabel{subsec:cross_site_generalization}{{4.3.4}{64}{}{subsection.4.3.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.11}{\ignorespaces Cross-site generalization evaluated through the difference in Mean Absolute Error ($\Delta $ MAE) between El Puntal and Salinas. Values closer to the zero vertical line indicate higher robustness to changing environmental conditions. The DL-based models (right panel) demonstrate near-perfect generalization compared to the highly site-dependent Index-based baseline (left panel).}}{65}{}\protected@file@percent }
\newlabel{fig:delta_mae_lollipop}{{4.11}{65}{}{figure.4.11}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.3.5}Final Multi-Criteria Ranking}{66}{}\protected@file@percent }
\newlabel{sec:final_ranking}{{4.3.5}{66}{}{subsection.4.3.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.12}{\ignorespaces Overall multi-criteria performance heatmap. The matrix displays the absolute values for MAD, IQR, MAE, Bias, RMSE, and $R^2$ across all evaluated models. The best absolute value for each metric is highlighted in bold, showcasing the Deep Learning dominance and the anomalous central-tendency precision of the SCoWI (LM Otsu) index.}}{67}{}\protected@file@percent }
\newlabel{fig:overall_metrics_heatmap}{{4.12}{67}{}{figure.4.12}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.13}{\ignorespaces Comprehensive bump chart ranking based on the six geometric and statistical metrics (1 = Best Performance). The arithmetic mean of these ranks dictates the global hierarchy, highlighting the Top 3 global architectures (U-Net MiT-B2, DeepLabV3+ MiT-B4, and U-Net EfficientNet-B4).}}{68}{}\protected@file@percent }
\newlabel{fig:bump_chart_ranking}{{4.13}{68}{}{figure.4.13}{}}
