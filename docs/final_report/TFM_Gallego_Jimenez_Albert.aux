\@writefile{toc}{\contentsline {section}{\numberline {4.3}Geometric Evaluation: Cross-shore Offsets}{46}{}\protected@file@percent }
\newlabel{sec:results_geometric_eval}{{4.3}{46}{}{section.4.3}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.3.1}Overarching Family Performance (Index-based vs. Deep Learning)}{46}{}\protected@file@percent }
\newlabel{subsec:overarching_performance}{{4.3.1}{46}{}{subsection.4.3.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.2}{\ignorespaces Distribution of cross-shore extraction offsets by model family. The left panel (Boxplot) displays the aggregated global performance, highlighting the median and interquartile range (IQR). The right panel (Violin plot) disaggregates the errors by study area (El Puntal vs. Salinas), emphasizing the severe performance degradation of index-based methods in complex environments compared to the geographic robustness of DL models.}}{47}{}\protected@file@percent }
\newlabel{fig:overall_family_boxplots}{{4.2}{47}{}{figure.4.2}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.3.2}Intra-Family Model Assessment and Spatial Bias}{47}{}\protected@file@percent }
\newlabel{subsec:intra_family_assessment}{{4.3.2}{47}{}{subsection.4.3.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.3}{\ignorespaces Mean Absolute Error (MAE) heatmaps for intra-family configuration assessment. The left panel details the performance of spectral indices across different thresholding techniques, highlighting extreme variance. The right panel displays the Deep Learning configurations, demonstrating high stability and the superiority of the U-Net (MiT-B2) hybrid architecture.}}{49}{}\protected@file@percent }
\newlabel{fig:mae_heatmaps}{{4.3}{49}{}{figure.4.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.4}{\ignorespaces Hexbin error distributions for Index-based models. The plots map the predicted shoreline position (SDW) against the reference waterline (RWL). The dashed white line represents the 1:1 perfect agreement. Most indices show a severe Landward bias (wet sand confusion), while NDWI shows a Seaward bias (foam confusion). SCoWI (LM Otsu) stands out as the most accurate traditional method.}}{51}{}\protected@file@percent }
\newlabel{fig:hexbins_index}{{4.4}{51}{}{figure.4.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.5}{\ignorespaces Hexbin error distributions for Deep Learning semantic segmentation models. In contrast to the traditional baseline, all DL configurations demonstrate minimal dispersion, uniformly tight clustering around the 1:1 bisector ($R^2 \ge 0.96$), and the complete elimination of extreme cross-shore biases.}}{52}{}\protected@file@percent }
\newlabel{fig:hexbins_dl}{{4.5}{52}{}{figure.4.5}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.3.3}Spatial and Environmental Drivers of Error}{53}{}\protected@file@percent }
\newlabel{subsec:spatial_environmental_drivers}{{4.3.3}{53}{}{subsection.4.3.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.6}{\ignorespaces Alongshore variability of extraction offsets for Index-based models. The upper map panels reference the geographical location of the cross-shore transects. The boxplots show the error distribution per \texttt  {transect\_id} compared to the overall site performance (right sub-panels).}}{54}{}\protected@file@percent }
\newlabel{fig:transects_index}{{4.6}{54}{}{figure.4.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.7}{\ignorespaces Alongshore variability of extraction offsets for Deep Learning models. The upper map panels reference the geographical location of the cross-shore transects. The boxplots show the error distribution per \texttt  {transect\_id} compared to the overall site performance (right sub-panels).}}{55}{}\protected@file@percent }
\newlabel{fig:transects_dl}{{4.7}{55}{}{figure.4.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.8}{\ignorespaces Relative performance sensitivity to hydrodynamic forcing. The plots display the percentage change in the median offset ($\Delta \%$) relative to the overall site median across astronomical tide (left) and significant wave height (right) quartiles. Absolute median values are annotated for each quartile to contextualize the operational impact of these relative changes.}}{57}{}\protected@file@percent }
\newlabel{fig:quartiles_relative}{{4.8}{57}{}{figure.4.8}{}}
